{
  "name": "electron-vue-template",
  "version": "0.0.0",
  "author": "sky <https://github.com/umbrella22>",
  "description": "An electron-vue project",
  "license": "MIT",
  "main": "./dist/electron/main/main.js",
  "scripts": {
    "dev": "tsx .electron-vue/dev-runner.ts",
    "dev:sit": "tsx .electron-vue/dev-runner.ts -m sit",
    "build": "tsx .electron-vue/build.ts && electron-builder -c build.json",
    "build:win32": "tsx .electron-vue/build.ts && electron-builder -c build.json --win  --ia32",
    "build:win64": "tsx .electron-vue/build.ts && electron-builder -c build.json --win  --x64",
    "build:mac": "tsx .electron-vue/build.ts && electron-builder -c build.json --mac",
    "build:dir": "tsx .electron-vue/build.ts && electron-builder -c build.json --dir",
    "build:clean": "tsx .electron-vue/build.ts --clean",
    "build:web": "tsx .electron-vue/build.ts --target web",
    "pack:resources": "tsx .electron-vue/hot-updater.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@iconify-json/tdesign": "^1.2.11",
    "@ikaros-cli/prettier-config": "^0.8.0",
    "@ikaros-cli/stylelint-config": "^0.8.0",
    "@rspack/core": "^2.0.6",
    "@rspack/dev-server": "^2.0.3",
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.9.2",
    "@types/semver": "^7.7.1",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/preset-wind4": "^66.7.0",
    "@vizejs/rspack-plugin": "^0.188.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.17.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "del": "7.1.0",
    "detect-port": "^2.1.0",
    "dotenv": "16.5.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.2",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "fs-extra": "^11.3.5",
    "highlight.js": "^11.11.1",
    "listr2": "^10.2.1",
    "minimist": "^1.2.8",
    "naive-ui": "^2.44.1",
    "pinia": "3.0.4",
    "rspack-unocss-plugin": "^0.1.0",
    "sass-embedded": "^1.100.0",
    "sass-loader": "^17.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unocss": "^66.7.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  }
}
